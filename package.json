{
  "name": "react-dnd-native",
  "version": "0.1.0",
  "description": "A small, generic drag-and-drop library for React built on the native HTML5 Drag and Drop API — no external dependencies.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/react-dnd-native.cjs",
  "module": "./dist/react-dnd-native.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-dnd-native.js",
      "require": "./dist/react-dnd-native.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build -c vite.lib.config.ts && cp lib/style.css dist/style.css",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.75.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^4.5.0"
  }
}
