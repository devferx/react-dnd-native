{
  "name": "react-dnd-native",
  "version": "0.1.0",
  "description": "A small, generic drag-and-drop library for React built on the native HTML5 Drag and Drop API — no external dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "Fernando Quinteros Gutierrez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devferx/react-dnd-native.git"
  },
  "homepage": "https://github.com/devferx/react-dnd-native#readme",
  "bugs": {
    "url": "https://github.com/devferx/react-dnd-native/issues"
  },
  "keywords": [
    "react",
    "drag-and-drop",
    "dnd",
    "html5",
    "drag",
    "drop"
  ],
  "main": "./dist/react-dnd-native.cjs",
  "module": "./dist/react-dnd-native.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/react-dnd-native.js",
      "require": "./dist/react-dnd-native.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build -c vite.lib.config.ts && cp lib/style.css dist/style.css",
    "build:demo": "vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build",
    "release": "npm publish --access public"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.75.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^4.1.10"
  }
}
